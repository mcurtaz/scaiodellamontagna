---
import { SITE_NAME } from "../lib/site";

interface Props {
  active?: "articoli" | "itinerari";
}

const { active } = Astro.props;

const links = [
  { key: "articoli", label: "Articoli", href: "/articoli" },
  { key: "itinerari", label: "Itinerari", href: "/itinerari" },
] as const;
---

<nav
  class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-8 md:px-14 border-b border-inchiostro/20"
>
  <div class="flex flex-wrap gap-x-6 gap-y-2 font-display text-[13.5px] text-inchiostro/82">
    {links.map((link) => (
      link.key === active ? (
        <span class="text-verde font-medium border-b-2 border-terra pb-[5px]">{link.label}</span>
      ) : (
        <a href={link.href} class="hover:text-inchiostro">{link.label}</a>
      )
    ))}
  </div>
  <a href="/" class="font-display font-medium text-[17px] tracking-tight text-inchiostro">
    {SITE_NAME}
  </a>
</nav>
