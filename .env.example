# Directus instance URL (local Docker or production)
DIRECTUS_URL=http://localhost:8055

# Static token from an API Reader role with read-only access to published posts
DIRECTUS_TOKEN=your-static-token-here

# The public URL of the deployed site (used by sitemap & RSS)
PUBLIC_SITE_URL=https://scaiodellamontagna.it

# PostgreSQL password (used by both postgres and directus services)
POSTGRES_PASSWORD=change-me

# Directus internal secret key (long random string)
DIRECTUS_SECRET=change-me-to-a-long-random-string

# Directus admin credentials
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
